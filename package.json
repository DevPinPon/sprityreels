{
  "name": "sprityreels",
  "private": true,
  "version": "0.1.0",
  "description": "Turn long videos into scroll-stopping vertical reels.",
  "type": "module",
  "scripts": {
    "dev": "tsx server/main.ts --dev",
    "build": "npm run typecheck && vite build && node scripts/precompress.mjs",
    "start": "tsx server/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "bench": "tsx scripts/benchmark.ts",
    "setup:clips": "node scripts/setup-clip-tools.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
