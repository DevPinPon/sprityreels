# Copy this file to .env (it is git-ignored). Everything is optional: the defaults suit running on your own computer.
# Put each comment on its own line, and leave a setting commented out to keep its default.

# --- Server
PORT=3000
# Use 0.0.0.0 behind a reverse proxy.
HOST=127.0.0.1
# Where visitors' workspaces are stored (default ./.sprityreels/data).
# SPRITYREELS_DATA=
SPRITYREELS_MAX_UPLOAD_MB=1024

# --- Many visitors at once (see docs/SERVING.md; every setting is optional)
# Delete a visitor's videos and reels this many hours after their last visit. Off (0) keeps files until the visitor deletes them; turn it on for a public site.
# SPRITYREELS_RETENTION_HOURS=72
# Most a visitor may keep stored, in MB, and the longest video, in minutes (default 360).
# SPRITYREELS_MAX_WORKSPACE_MB=3000
# SPRITYREELS_MAX_VIDEO_MIN=120
# Minutes of video one visitor may import per day (UTC): the most direct cost control. 0 or empty: no limit.
# SPRITYREELS_MAX_MINUTES_PER_DAY=60
# Uploads stop while the data disk has less than this many GB free (default 2).
# SPRITYREELS_MIN_FREE_GB=2
# Slots per kind of work for the whole machine, sized from its cores and memory by default: net, prep, gpu (speech recognition), ai, render, track, scan.
# SPRITYREELS_CAPACITY=gpu=1,render=3,track=2,scan=2
# Refuse new imports and renders (503, try later) when this many steps already wait, and when one visitor has this many jobs going.
# SPRITYREELS_MAX_BACKLOG=400
# SPRITYREELS_MAX_JOBS=60
# Working frames go in RAM instead of the data folder (Linux).
# SPRITYREELS_FRAMES_DIR=/dev/shm/sprityreels-frames
# AI spend limits at list price per UTC day, in dollars: for the whole service and for one visitor. 0 or empty: no limit.
# SPRITYREELS_AI_USD_PER_DAY=20
# SPRITYREELS_AI_USD_PER_VISITOR_DAY=0.5
# A secret of 16 or more characters that opens /api/metrics (queue depth, spend) for monitoring and autoscaling. Without it the endpoint does not exist.
# SPRITYREELS_OPERATOR_KEY=
# Render cost: x264 preset (default veryfast) and quality (default CRF 21); medium and 19 are the old, slower, larger defaults.
# SPRITYREELS_X264_PRESET=veryfast
# SPRITYREELS_X264_CRF=21
# NVENC quality (default 23) and bit-rate ceiling (default 12M).
# SPRITYREELS_NVENC_CQ=23
# SPRITYREELS_NVENC_MAXRATE=12M
# The picture pass (motion in the video, for action picks) runs only for videos that can have action picks: gaming, sports, little speech.
# always: for every video (costs about 8.6 core-minutes per hour of 1080p).
# SPRITYREELS_PICTURE_PASS=auto
# Frames a second the tracker looks at (2 to 15, default 8).
# SPRITYREELS_TRACK_FPS=8
# Set to 1 when the site is served over HTTPS.
SPRITYREELS_SECURE_COOKIES=0
# Extra trusted origins when a reverse proxy rewrites the Host header, e.g. https://sprityreels.com
# SPRITYREELS_ORIGINS=
# Sites that links may come from (comma-separated host names). Default: the big video sites. * allows any public host.
# SPRITYREELS_LINK_HOSTS=

# --- AI picks (optional; without a key the automatic picks still work)
# Claude reads the transcript and looks at frames of the video (billed per token by Anthropic).
# ANTHROPIC_API_KEY=
# claude-opus-5-5 is the default; claude-sonnet-5-5 is half the price (compare their picks before switching).
# SPRITYREELS_CLAUDE_MODEL=
# low, medium, high, xhigh or max: how hard Claude thinks (default medium).
# SPRITYREELS_CLAUDE_EFFORT=
# Gemini reads the transcript only.
# GEMINI_API_KEY=
# Cache the transcript and pictures for five minutes: pays off only when a video is asked about more than about once in five minutes.
# SPRITYREELS_CLAUDE_CACHE=1
# AI-assisted requests allowed per visitor per hour.
SPRITYREELS_AI_PER_HOUR=12

# --- Working frames
# Frames of a visitor's video are kept in memory or in <data>/frames and deleted when the reels are delivered; this is the
# longest, in minutes, that a step may hold them before a sweep deletes them anyway.
# SPRITYREELS_FRAME_TTL_MIN=120

# --- Tools (npm run setup:clips installs pinned copies on Windows; elsewhere install them and point to them here)
# SPRITYREELS_YTDLP=
# SPRITYREELS_WHISPER_CLI=
# SPRITYREELS_WHISPER_MODEL=
# Chrome, Edge or Chromium for the face and subject tracker.
# SPRITYREELS_BROWSER=
# x264 forces the CPU encoder.
# SPRITYREELS_CLIPS_ENCODER=
